%% =============================================================
%% Referências bibliográficas do TCC
%% Tema: Poda neural para redução de consumo de energia
%% =============================================================
%% Formato: BibTeX compatível com o pacote abntex2cite
%% Estilo: abntex2-alf-ufvjm.bst (cópia local de abntex2-alf ajustada ao Manual de
%% Normalização da UFVJM, 2025: NBR 6023:2018 e NBR 10520:2023).
%% Convenções adotadas em 14/11/2026 (normalização):
%% - livros e documentos on-line: título em caixa de frase (manual, 6.3.1 b);
%% - artigos e trabalhos em evento: o estilo põe o título em caixa de frase; a inicial
%%   do subtítulo vai minúscula no próprio campo, e nomes próprios ficam entre chaves;
%% - livros e documentos on-line com subtítulo: campo subtitle, que sai sem negrito;
%% - autor entidade no campo organization (maiúsculas na lista, caixa mista na chamada);
%% - trabalho em evento: organization (nome do evento), conference-number,
%%   conference-year e conference-location, para gerar
%%   "In: NOME DO EVENTO, n., ano, Cidade. Proceedings [...]" (manual, 6.6).
%% =============================================================

%% -------- Opção do estilo (não é referência) --------
%% Chamada no texto em caixa mista também entre parênteses, "(Han et al., 2015)",
%% como exige a NBR 10520:2023 (Manual de Normalização da UFVJM, 2025, item 5.1).
%% Entrada própria porque a opção equivalente do abntex2-options.bib
%% ("abnt-cite-style=AuthorYEAR") colide com "AUTHORYEAR": o BibTeX não distingue
%% maiúsculas de minúsculas nas chaves e descarta a segunda. Ativada pela opção
%% ufvjm-citacao-nbr10520-2023 do pacote abntex2cite, no principal.tex.
@ABNT-options{ufvjm-citacao-nbr10520-2023,
  key             = {ufvjm-citacao-nbr10520-2023},
  abnt-cite-style = "(Author, YEAR)"
}


